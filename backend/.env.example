# Copy this file to backend/.env and add your own WeatherAPI key.
# The real .env file is ignored by Git and must never be committed.
WEATHER_API_KEY=
# Comma-separated browser origins (scheme + host + port, no trailing slash).
# Override the local defaults for a hosted web demo; never use *.
# WEB_ALLOWED_ORIGINS=https://demo.example.org
ALERTS_IN_UA_TOKEN=
# Private editor key. Set a long random value only in backend/.env, never in mobile/.env.
EDITORIAL_ADMIN_KEY=
# Required for manual GTFS import; never expose in mobile/.env.
TRANSPORT_IMPORT_TOKEN=
# Optional override for the public Zakarpattia utility widget adapter (no API key required).
POWER_OUTAGE_API_URL=https://api-outage-zakarpat-energy.inneti.net/api
