{
  "expo": {
    "name": "Ужгород Цифровий",
    "slug": "uzhhorod-digital",
    "icon": "./assets/brand/uzhhorod-digital-logo.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Дозвольте Ужгород Цифровий використовувати камеру для зчитування QR-коду автобуса.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-asset"
    ]
  }
}
